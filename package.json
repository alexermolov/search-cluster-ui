{
  "name": "opensearch-ui",
  "productName": "Search Cluster UI",
  "private": true,
  "version": "0.6.1",
  "description": "Desktop client for Elasticsearch and OpenSearch clusters",
  "author": "Search Cluster UI Team",
  "main": "dist/main/index.js",
  "scripts": {
    "release": "npm run release:patch",
    "release:patch": "npm version patch -m \"chore(release): v%s\" && npm run release:push",
    "release:minor": "npm version minor -m \"chore(release): v%s\" && npm run release:push",
    "release:major": "npm version major -m \"chore(release): v%s\" && npm run release:push",
    "release:push": "git push origin main --follow-tags",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "package:win": "node scripts/package-win.mjs",
    "dist:win": "npm run build && electron-builder --win",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.renderer.json",
    "start": "electron ."
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "codemirror": "^6.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^33.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
